{
  "uid": "bybit-bot-health",
  "title": "Bybit ShortBot · Bot Health",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "1m",
  "tags": [
    "bybit-shortbot",
    "monitoring-stage3",
    "managed-by-terraform"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "constant",
        "query": "__ENVIRONMENT__",
        "hide": 0,
        "current": {
          "text": "__ENVIRONMENT__",
          "value": "__ENVIRONMENT__"
        }
      },
      {
        "name": "operation",
        "label": "API operation (charts)",
        "type": "custom",
        "query": "get_instruments_info,get_tickers,get_kline,get_wallet_balance,place_order,get_positions,get_order_history,get_closed_pnl,get_open_orders,cancel_order,other",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ],
          "selected": true
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Bot progress",
      "description": "Main-thread progress only. Green does not assert a successful candle or profitable trading.",
      "datasource": {
        "type": "prometheus",
        "uid": "__METRICS_DATASOURCE_UID__"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "NO DATA",
                  "color": "gray"
                },
                "0": {
                  "text": "STALE",
                  "color": "red"
                },
                "1": {
                  "text": "PROGRESSING",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__METRICS_DATASOURCE_UID__"
          },
          "editorMode": "code",
          "expr": "(time() - max(bot_main_progress_timestamp_seconds{bot=\"bybit-shortbot\",component=\"trading-bot\",environment=\"__ENVIRONMENT__\"}) <= bool 180) or on() vector(-1)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
