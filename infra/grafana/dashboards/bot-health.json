    {
      "id": 11,
      "type": "timeseries",
      "title": "Bybit SDK requests / s (15m window)",
      "description": "Existing SDK invocations, not physical HTTP retries. Quiet intervals between candles are normal.",
      "datasource": {
        "type": "prometheus",
        "uid": "__METRICS_DATASOURCE_UID__"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__METRICS_DATASOURCE_UID__"
          },
          "editorMode": "code",
          "expr": "sum by (operation, result) (rate(bot_api_requests_total{bot=\"bybit-shortbot\",component=\"trading-bot\",environment=\"__ENVIRONMENT__\",operation=~\"${operation:regex}\"}[15m]))",
          "refId": "A",
          "legendFormat": "{{operation}} / {{result}}",
          "instant": false,
          "range": true
        }
      ]
    },
